<Window x:Class="FrontolFileAnalyzer.MarkingCodesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справочник кодов номенклатуры и маркировки"
        Icon="Assets/app.ico"
        Width="760" Height="650" MinWidth="560" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        UseLayoutRounding="True"
        ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" Background="White" BorderBrush="#CFCFCF" BorderThickness="1">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Коды типа номенклатуры / маркировки"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,3,0,0" Foreground="#555555"
                           Text="Поле 55 товарных команд Frontol. Значение по умолчанию - 0."
                           TextWrapping="Wrap" />
                <TextBox Margin="0,7,0,0" MinWidth="160" MaxWidth="360" HorizontalAlignment="Left"
                         TextChanged="Search_TextChanged" ToolTip="Поиск по коду и наименованию" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0,6,0,6">
            <TabItem Header="Типы номенклатуры">
                <DataGrid x:Name="CodesGrid" ItemsSource="{Binding CodesView}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="All"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          RowHeaderWidth="0" AlternatingRowBackground="#F8F8F8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="90" />
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Где используется" Binding="{Binding Description}" Width="250" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Связанные параметры маркировки">
                <DataGrid ItemsSource="{Binding RelatedCodes}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="All"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          RowHeaderWidth="0" AlternatingRowBackground="#F8F8F8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Поле и код" Binding="{Binding Code}" Width="110" />
                        <DataGridTextColumn Header="Значение" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Примечание" Binding="{Binding Description}" Width="260" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Foreground="#555555" TextWrapping="Wrap"
                       Text="Источник: Руководство интегратора Frontol 6, поле 55, страницы 195-198." />
            <WrapPanel Grid.Row="1" Margin="0,5,0,0" HorizontalAlignment="Right">
                <Button Margin="6,0,0,0" Click="CopySelected_Click" Content="Копировать выбранное" />
                <Button Margin="6,0,0,0" IsDefault="True" Click="Close_Click" Content="Закрыть" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
