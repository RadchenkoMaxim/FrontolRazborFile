<Window x:Class="FrontolFileAnalyzer.RecordColumnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Колонки списка строк" Width="430" Height="430" MinWidth="390" MinHeight="330"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Margin="0,0,0,8" Text="Отметьте колонки, которые должны быть видны в левом списке." TextWrapping="Wrap" />
        <DataGrid Grid.Row="1" ItemsSource="{Binding Options}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  RowHeaderWidth="0" AlternatingRowBackground="#F7F7F7">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Показывать" Binding="{Binding IsVisible}" Width="95" />
                <DataGridTextColumn Header="Колонка" Binding="{Binding Header}" Width="*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button HorizontalAlignment="Left" Padding="10,3" Content="Сбросить размеры" Click="Reset_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="80" Margin="0,0,7,0" IsDefault="True" Content="ОК" Click="Ok_Click" />
                <Button Width="80" IsCancel="True" Content="Отмена" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
