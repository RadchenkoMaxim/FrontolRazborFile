<Window x:Class="FrontolFileAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:FrontolFileAnalyzer.Core;assembly=FrontolFileAnalyzer.Core"
        xmlns:local="clr-namespace:FrontolFileAnalyzer"
        Title="Анализатор файла обмена Frontol"
        Icon="Assets/app.ico"
        Width="1440" Height="820" MinWidth="720" MinHeight="390"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F7F7F7" BorderBrush="#D2D2D2" BorderThickness="0,0,0,1">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Определить формат автоматически..." InputGestureText="Ctrl+O" Click="OpenFile_Click" IsEnabled="{Binding CanStartLoad}" />
                <MenuItem Header="Файл _загрузки в Frontol..." Click="OpenUploadFile_Click" IsEnabled="{Binding CanStartLoad}" />
                <MenuItem Header="_Отчёт о продажах из Frontol..." Click="OpenSalesReport_Click" IsEnabled="{Binding CanStartLoad}" />
                <Separator />
                <MenuItem Header="_Сохранить" InputGestureText="Ctrl+S" Click="SaveFile_Click" IsEnabled="{Binding CanSaveChanges}" />
                <MenuItem Header="Сохранить _как..." InputGestureText="Ctrl+Shift+S" Click="SaveFileAs_Click" IsEnabled="{Binding CanSaveFile}" />
                <Separator />
                <MenuItem Header="_Экспорт видимых строк..." Click="Export_Click" IsEnabled="{Binding HasLoadedRecords}" />
                <MenuItem Header="С_равнить с файлом..." Click="Compare_Click" IsEnabled="{Binding CanUseUploadTools}" />
                <MenuItem Header="_Последние файлы" x:Name="RecentFilesMenu" />
                <Separator />
                <MenuItem Header="Открыть _исходный файл" Click="OpenSourceFile_Click" IsEnabled="{Binding CanOpenCurrentFile}" />
                <MenuItem Header="Показать в _папке" Click="ShowInFolder_Click" IsEnabled="{Binding CanOpenCurrentFile}" />
                <Separator />
                <MenuItem Header="_Выход" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Правка">
                <MenuItem Header="Изменить выбранное поле..." InputGestureText="F2"
                          Click="EditField_Click" IsEnabled="{Binding CanEditSelectedField}" />
                <MenuItem Header="Расширенное редактирование строки..." Click="EditRawLine_Click"
                          IsEnabled="{Binding CanEditRawLine}" />
                <Separator />
                <MenuItem Header="Массово изменить вид маркировки..." InputGestureText="Ctrl+Shift+M"
                          Click="BulkEditMarking_Click" IsEnabled="{Binding CanUseUploadTools}" />
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="Скрыть / показать список строк" InputGestureText="Ctrl+M" Click="ToggleRecordsPane_Click" />
                <Separator />
                <MenuItem Header="Показывать пустые поля" IsCheckable="True" IsChecked="{Binding ShowEmptyFields, Mode=TwoWay}" />
                <MenuItem Header="Настроить видимость полей..." Click="ConfigureFields_Click" IsEnabled="{Binding CanConfigureFields}" />
                <MenuItem Header="Колонки списка строк..." Click="ConfigureRecordColumns_Click" />
                <Separator />
                <MenuItem Header="Перейти к физической строке..." InputGestureText="Ctrl+G" Click="GoToLine_Click" IsEnabled="{Binding HasLoadedRecords}" />
                <MenuItem Header="Сводная статистика файла..." Click="Statistics_Click" IsEnabled="{Binding HasLoadedRecords}" />
            </MenuItem>
            <MenuItem Header="_Справка">
                <MenuItem Header="Команды и поля загрузки" Click="CommandReference_Click" />
                <MenuItem Header="Транзакции и поля отчёта о продажах" Click="SalesReference_Click" />
                <MenuItem Header="Коды номенклатуры и маркировки" Click="MarkingCodes_Click" />
                <Separator />
                <MenuItem Header="О программе" Click="About_Click" />
            </MenuItem>
        </Menu>

        <ToolBarTray Grid.Row="1" IsLocked="True" Background="#F3F3F3">
            <ToolBar Band="0" BandIndex="0" Padding="4,2" ToolBarTray.IsLocked="True">
                <Button Click="OpenFile_Click" IsEnabled="{Binding CanStartLoad}" ToolTip="Открыть файл (Ctrl+O)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource IconOpen}" /><TextBlock Text="Открыть" /></StackPanel>
                </Button>
                <Button Click="SaveFile_Click" IsEnabled="{Binding CanSaveChanges}" ToolTip="Сохранить изменения (Ctrl+S)">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource IconSave}" /><TextBlock Text="Сохранить" /></StackPanel>
                </Button>
                <Button Click="Export_Click" IsEnabled="{Binding HasLoadedRecords}" ToolTip="Экспортировать строки, оставшиеся после фильтра">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource IconExport}" /><TextBlock Text="Экспорт" /></StackPanel>
                </Button>
                <Button Click="Compare_Click" IsEnabled="{Binding CanUseUploadTools}" ToolTip="Сравнить товары двух файлов загрузки">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource IconCompare}" /><TextBlock Text="Сравнить" /></StackPanel>
                </Button>
                <Button Click="BulkEditMarking_Click" IsEnabled="{Binding CanUseUploadTools}"
                        ToolTip="Массово заменить вид маркировки у выбранных групп">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolbarIcon}" Stroke="{StaticResource MarkingBrush}" Data="{StaticResource IconMarking}" /><TextBlock Text="Маркировка" /></StackPanel>
                </Button>
                <Separator />
                <Button x:Name="CurrentReferenceButton" Click="CurrentReference_Click" ToolTip="Справочник команд и полей">
                    <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource IconHelp}" /><TextBlock Text="Справка" /></StackPanel>
                </Button>
                <Button Click="ConfigureRecordColumns_Click" ToolTip="Показать или скрыть колонки списка"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource IconColumns}" /><TextBlock Text="Колонки" /></StackPanel></Button>
                <Button Click="GoToLine_Click" IsEnabled="{Binding HasLoadedRecords}" ToolTip="Перейти к физической строке (Ctrl+G)"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource IconGoto}" /><TextBlock Text="К строке" /></StackPanel></Button>
                <Button Click="Statistics_Click" IsEnabled="{Binding HasLoadedRecords}" ToolTip="Сводная статистика файла"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource IconStats}" /><TextBlock Text="Сводка" /></StackPanel></Button>
                <Button Click="OpenSourceFile_Click" IsEnabled="{Binding CanOpenCurrentFile}" Content="Открыть исходный" />
                <Button Click="ShowInFolder_Click" IsEnabled="{Binding CanOpenCurrentFile}" Content="В папке" />
                <Separator />
                <TextBlock Margin="6,0,4,0" VerticalAlignment="Center" Foreground="#555555" Text="Файл:" />
                <TextBlock Width="390" Padding="4,0" VerticalAlignment="Center"
                           Text="{Binding FileDisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FilePath, Mode=OneWay}" />
            </ToolBar>
        </ToolBarTray>

        <Border Grid.Row="2" Padding="8,5" Background="White" BorderBrush="#D2D2D2" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Text="{Binding RecordCountLabel}" />
                    <Border Margin="14,0" BorderBrush="#BFBFBF" BorderThickness="1,0,0,0" />
                    <TextBlock Text="{Binding EncodingLabel}" />
                    <Border Margin="14,0" BorderBrush="#BFBFBF" BorderThickness="1,0,0,0" />
                    <TextBlock Text="{Binding ProblemCountLabel}" />
                    <Border Margin="14,0" BorderBrush="#BFBFBF" BorderThickness="1,0,0,0" />
                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding FileKindLabel}" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,7,0,0" IsEnabled="{Binding HasLoadedRecords}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.78*" />
                        <ColumnDefinition Width="1.65*" />
                        <ColumnDefinition Width="0.95*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,2" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="Поиск" />
                        <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" ToolTip="Поиск по строке, коду, названию, команде и маркировке" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,2" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="Раздел" />
                        <ComboBox x:Name="SectionFilterBox" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="Все разделы" />
                        <ComboBoxItem x:Name="ProductSectionFilter" Content="Товары" />
                        <ComboBoxItem x:Name="ServiceSectionFilter" Content="Служебные" />
                        <ComboBoxItem Content="Структура файла" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock x:Name="CommandFilterCaption" Margin="0,0,0,2" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="Команда" />
                        <ComboBox MaxDropDownHeight="430" ItemsSource="{Binding CommandFilters}"
                                  SelectedItem="{Binding SelectedCommandFilter, Mode=TwoWay}"
                                  ToolTip="{Binding SelectedItem.Description, RelativeSource={RelativeSource Self}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock MaxWidth="610" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="300" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,2" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="Состояние" />
                        <ComboBox x:Name="SeverityFilterBox" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                        <ComboBoxItem Content="Все строки" />
                        <ComboBoxItem Content="Ошибки и предупреждения" />
                        <ComboBoxItem Content="Только ошибки" />
                        <ComboBoxItem Content="Без замечаний" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Margin="0,0,0,2" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="Маркировка" />
                        <Button Padding="8,2" HorizontalContentAlignment="Left"
                                Content="{Binding MarkingFilterLabel}" Click="ConfigureMarkingFilter_Click"
                                ToolTip="Выбрать один или несколько видов маркировки" />
                    </StackPanel>
                    <Button Grid.Column="5" MinWidth="92" VerticalAlignment="Bottom" Padding="8,2"
                            Content="Сбросить" Click="ResetFilters_Click"
                            ToolTip="Очистить поиск и все фильтры" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Padding="8,5" Background="#EAF3FB" BorderBrush="#AFC9E0" BorderThickness="0,0,0,1"
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding LoadProgressText}" />
                <ProgressBar Grid.Column="1" Height="16" Minimum="0" Maximum="100"
                             Value="{Binding LoadProgressValue, Mode=OneWay}" IsIndeterminate="{Binding LoadProgressIsIndeterminate, Mode=OneWay}" />
            </Grid>
        </Border>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="4" Margin="6" Padding="2">
            <TabItem x:Name="SalesOverviewTab" Header="Обзор">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border Padding="12,9" Background="#EEF5FB" BorderBrush="#BCD2E4" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Понятный отчёт о продажах" />
                                    <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding SalesReport.Overview.PeriodText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" MaxWidth="560" VerticalAlignment="Center">
                                    <TextBlock TextAlignment="Right" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                               Text="Итоги собраны только из завершённых продаж и возвратов. Незавершённые и служебные документы показаны отдельно." />
                                    <StackPanel Margin="0,3,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="БД: " /><TextBlock FontWeight="SemiBold" Text="{Binding SalesReport.Overview.DatabaseId}" />
                                        <TextBlock Margin="10,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Отчёт: " /><TextBlock FontWeight="SemiBold" Text="{Binding SalesReport.Overview.ReportNumber}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <UniformGrid Margin="0,10,0,0" Rows="2" Columns="4">
                            <Border Margin="4" Padding="12,9" Background="White" BorderBrush="#D8E0E8" BorderThickness="1" CornerRadius="4">
                                <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Продажи" /><TextBlock FontSize="23" FontWeight="SemiBold" Text="{Binding SalesReport.Overview.GrossSales, StringFormat={}{0:N2}}" /><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding SalesReport.Overview.SalesDocumentCount, StringFormat=документов: {0:N0}}" /></StackPanel>
                            </Border>
                            <Border Margin="4" Padding="12,9" Background="White" BorderBrush="#E5D2D2" BorderThickness="1" CornerRadius="4">
                                <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Возвраты" /><TextBlock FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" Text="{Binding SalesReport.Overview.Returns, StringFormat={}{0:N2}}" /><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding SalesReport.Overview.ReturnDocumentCount, StringFormat=документов: {0:N0}}" /></StackPanel>
                            </Border>
                            <Border Margin="4" Padding="12,9" Background="#F1F8F3" BorderBrush="#C8DDCE" BorderThickness="1" CornerRadius="4">
                                <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Итог продаж" /><TextBlock FontSize="23" FontWeight="Bold" Foreground="{StaticResource MarkingBrush}" Text="{Binding SalesReport.Overview.NetSales, StringFormat={}{0:N2}}" /><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Продажи минус возвраты" /></StackPanel>
                            </Border>
                            <Border Margin="4" Padding="12,9" Background="White" BorderBrush="#D8E0E8" BorderThickness="1" CornerRadius="4">
                                <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Средний документ продажи" /><TextBlock FontSize="23" FontWeight="SemiBold" Text="{Binding SalesReport.Overview.AverageDocument, StringFormat={}{0:N2}}" /><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="По закрытым продажам" /></StackPanel>
                            </Border>
                            <Border Margin="4" Padding="12,9" Background="White" BorderBrush="#D8E0E8" BorderThickness="1" CornerRadius="4">
                                <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Документы" /><TextBlock FontSize="23" FontWeight="SemiBold" Text="{Binding SalesReport.Overview.DocumentCount, StringFormat={}{0:N0}}" /><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding SalesReport.Overview.OpenDocumentCount, StringFormat=незавершено: {0:N0}}" /></StackPanel>
                            </Border>
                            <Border Margin="4" Padding="12,9" Background="White" BorderBrush="#D8E0E8" BorderThickness="1" CornerRadius="4">
                                <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Товарные строки" /><TextBlock FontSize="23" FontWeight="SemiBold" Text="{Binding SalesReport.Overview.ProductLineCount, StringFormat={}{0:N0}}" /><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding SalesReport.Overview.UniqueProductCount, StringFormat=товаров: {0:N0}}" /></StackPanel>
                            </Border>
                            <Border Margin="4" Padding="12,9" Background="White" BorderBrush="#D8E0E8" BorderThickness="1" CornerRadius="4">
                                <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Количество товара" /><TextBlock FontSize="23" FontWeight="SemiBold" Text="{Binding SalesReport.Overview.Quantity, StringFormat={}{0:N3}}" /><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="С учётом сторно и возвратов" /></StackPanel>
                            </Border>
                            <Border Margin="4" Padding="12,9" Background="White" BorderBrush="#D8E0E8" BorderThickness="1" CornerRadius="4">
                                <StackPanel><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Предприятия / группы" /><TextBlock FontSize="23" FontWeight="SemiBold" Text="{Binding SalesReport.Overview.PrintGroupCount, StringFormat={}{0:N0}}" /><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="{Binding SalesReport.Overview.EnterpriseCount, StringFormat=предприятий: {0:N0}}" /></StackPanel>
                            </Border>
                        </UniformGrid>
                        <GroupBox Margin="4,10,4,0" Header="Смены в отчёте" Padding="5">
                            <DataGrid ItemsSource="{Binding SalesReport.Shifts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Предприятие" Binding="{Binding EnterpriseId}" Width="90" />
                                    <DataGridTextColumn Header="РМ" Binding="{Binding Workstation}" Width="70" />
                                    <DataGridTextColumn Header="Смена" Binding="{Binding ShiftNumber}" Width="75" />
                                    <DataGridTextColumn Header="Открыта" Binding="{Binding OpenedText}" Width="140" />
                                    <DataGridTextColumn Header="Закрыта" Binding="{Binding ClosedText}" Width="140" />
                                    <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="190" />
                                    <DataGridTextColumn Header="Документов" Binding="{Binding DocumentCount, StringFormat={}{0:N0}}" Width="90" />
                                    <DataGridTextColumn Header="Возвратов" Binding="{Binding ReturnDocumentCount, StringFormat={}{0:N0}}" Width="80" />
                                    <DataGridTextColumn Header="По документам" Binding="{Binding NetSales, StringFormat={}{0:N2}}" Width="110" />
                                    <DataGridTextColumn Header="№61" Binding="{Binding ProgramSalesText}" Width="100" />
                                    <DataGridTextColumn Header="№63" Binding="{Binding HardwareSalesText}" Width="100" />
                                    <DataGridTextColumn Header="Сверка" Binding="{Binding ReconciliationText}" Width="115" />
                                    <DataGridTextColumn Header="Транзакций" Binding="{Binding TransactionCount, StringFormat={}{0:N0}}" Width="95" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SalesDocumentsTab" Header="Документы / 1С">
                <Grid Margin="7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="330" /><ColumnDefinition Width="6" /><ColumnDefinition Width="1.35*" MinWidth="430" /></Grid.ColumnDefinitions>
                    <GroupBox Header="Чеки и документы Frontol" Padding="4">
                        <DataGrid x:Name="SalesDocumentsGrid" ItemsSource="{Binding SalesReport.Documents}" SelectedItem="{Binding SelectedSalesDocument, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="125" />
                                <DataGridTextColumn Header="Предпр." Binding="{Binding EnterpriseId}" Width="65" />
                                <DataGridTextColumn Header="№" Binding="{Binding DisplayNumber}" Width="80" />
                                <DataGridTextColumn Header="Операция" Binding="{Binding OperationName}" Width="*" />
                                <DataGridTextColumn Header="Поз." Binding="{Binding ItemCount}" Width="48" />
                                <DataGridTextColumn Header="Итог" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="88" />
                                <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="105" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource DividerBrush}" />
                    <Grid Grid.Column="2" DataContext="{Binding SelectedSalesDocument}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Padding="11,8" Background="#EEF5FB" BorderBrush="#BCD2E4" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding OneCView, TargetNullValue=Выберите документ}" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Универсальное представление загрузки в 1С: шапка документа, товары, оплаты и исходные транзакции." />
                            </StackPanel>
                        </Border>
                        <UniformGrid Grid.Row="1" Margin="0,7" Rows="2" Columns="5">
                            <StackPanel Margin="4"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Документ" /><TextBlock FontWeight="SemiBold" Text="{Binding DisplayNumber}" /></StackPanel>
                            <StackPanel Margin="4"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Дата" /><TextBlock FontWeight="SemiBold" Text="{Binding DateText}" /></StackPanel>
                            <StackPanel Margin="4"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Касса / РМ" /><TextBlock FontWeight="SemiBold" Text="{Binding Workstation}" /></StackPanel>
                            <StackPanel Margin="4"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Смена" /><TextBlock FontWeight="SemiBold" Text="{Binding ShiftNumber}" /></StackPanel>
                            <StackPanel Margin="4"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Кассир / предприятие" /><TextBlock FontWeight="SemiBold"><Run Text="{Binding Cashier}" /><Run Text=" / " /><Run Text="{Binding EnterpriseId}" /></TextBlock></StackPanel>
                            <StackPanel Margin="4"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Операция" /><TextBlock FontWeight="SemiBold" Text="{Binding OperationName}" /></StackPanel>
                            <StackPanel Margin="4"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Количество" /><TextBlock FontWeight="SemiBold" Text="{Binding Quantity, StringFormat={}{0:N3}}" /></StackPanel>
                            <StackPanel Margin="4"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Товары" /><TextBlock FontWeight="SemiBold" Text="{Binding ItemsAmount, StringFormat={}{0:N2}}" /></StackPanel>
                            <StackPanel Margin="4"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Итог" /><TextBlock FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding Total, StringFormat={}{0:N2}}" /></StackPanel>
                            <StackPanel Margin="4"><TextBlock Foreground="{StaticResource MutedTextBrush}" Text="Группы печати" /><TextBlock FontWeight="SemiBold" Text="{Binding PrintGroupsText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PrintGroupsText}" /></StackPanel>
                        </UniformGrid>
                        <TabControl Grid.Row="2">
                            <TabItem Header="Для 1С по группам печати">
                                <DataGrid ItemsSource="{Binding PrintGroups}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Предприятие" Binding="{Binding EnterpriseId}" Width="90" />
                                        <DataGridTextColumn Header="Код ГП" Binding="{Binding PrintGroupCode}" Width="55" />
                                        <DataGridTextColumn Header="Группа печати" Binding="{Binding PrintGroupName}" Width="120" />
                                        <DataGridTextColumn Header="Документ 1С" Binding="{Binding OneCReport}" Width="200" />
                                        <DataGridTextColumn Header="Позиций" Binding="{Binding ProductLineCount}" Width="55" />
                                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity, StringFormat={}{0:N3}}" Width="75" />
                                        <DataGridTextColumn Header="Продажи" Binding="{Binding GrossSales, StringFormat={}{0:N2}}" Width="75" />
                                        <DataGridTextColumn Header="Возвраты" Binding="{Binding Returns, StringFormat={}{0:N2}}" Width="75" />
                                        <DataGridTextColumn Header="Итог" Binding="{Binding NetSales, StringFormat={}{0:N2}}" Width="75" />
