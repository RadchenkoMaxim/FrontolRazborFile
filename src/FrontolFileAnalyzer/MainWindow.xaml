            <TabItem x:Name="TransactionsTab" Header="Транзакции">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RecordsColumn" Width="655" MinWidth="300" />
                <ColumnDefinition Width="27" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="RecordsPanel" Grid.Column="0" Header="Строки файла" Padding="4" Background="White">
                <ListView x:Name="RecordsList" ItemsSource="{Binding RecordsView}"
                          SelectedItem="{Binding SelectedRecord}"
                          BorderThickness="0"
                          AlternationCount="2"
                          SizeChanged="RecordsList_SizeChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.Resources>
                        <ContextMenu x:Key="RecordContextMenu" x:Shared="False">
                            <MenuItem Header="Копировать исходную строку" Click="CopyRawLine_Click" />
                            <MenuItem Header="Копировать код" Click="CopyRecordCode_Click" />
                            <MenuItem Header="Копировать наименование" Click="CopyRecordName_Click" />
                            <Separator />
                            <MenuItem Header="Изменить исходную строку..." Click="EditRawLine_Click" />
                            <MenuItem Header="Открыть исходный файл" Click="OpenSourceFile_Click" />
                        </ContextMenu>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#26323A" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="2" />
                            <Setter Property="ContextMenu" Value="{StaticResource RecordContextMenu}" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="RecordItem_RightClick" />
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static core:IssueSeverity.Info}">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static core:IssueSeverity.Warning}">
                                    <Setter Property="Foreground" Value="{StaticResource ChangedBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static core:IssueSeverity.Error}">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsModified}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ChangedSoftBrush}" />
                                    <Setter Property="ToolTip" Value="Строка изменена и ещё не сохранена" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander IsExpanded="True" Margin="0,2,0,2">
                                                    <Expander.Header>
                                                        <Border Padding="7,5" Background="{StaticResource PrimarySoftBrush}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontWeight="Bold" Text="{Binding Name, Converter={StaticResource GroupNameConverter}}" />
                                                                <TextBlock Margin="7,0,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ItemCount, StringFormat=({0:N0})}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander IsExpanded="True" Margin="8,1,0,1">
                                                    <Expander.Header>
                                                        <DockPanel Background="{StaticResource SurfaceAltBrush}" LastChildFill="False">
                                                            <TextBlock Margin="6,3" FontFamily="Consolas" FontWeight="SemiBold" Text="{Binding Name}" />
                                                            <TextBlock Margin="0,3,6,3" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ItemCount, StringFormat=· {0:N0}}" />
                                                        </DockPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView x:Name="RecordsGridView" AllowsColumnReorder="True">
                            <GridViewColumn x:Name="LineColumn" Header="Строка" Width="52" DisplayMemberBinding="{Binding LineNumber}" />
                            <GridViewColumn x:Name="CommandColumn" Header="Команда" Width="108">
                                <GridViewColumn.CellTemplate><DataTemplate><local:HighlightedTextBlock HighlightText="{Binding CommandText}" SearchText="{Binding DataContext.SearchTextQuery, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis" /></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="CodeColumn" Header="Код" Width="88">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <local:HighlightedTextBlock FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                                   HighlightText="{Binding CodeDisplayText}" SearchText="{Binding DataContext.SearchTextQuery, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CodeDisplayText}" ToolTipService.InitialShowDelay="350" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="NameColumn" Header="Наименование" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <local:HighlightedTextBlock FontWeight="SemiBold" HighlightText="{Binding ContentText}" SearchText="{Binding DataContext.SearchTextQuery, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ContentText}" ToolTipService.InitialShowDelay="350" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="MarkingColumn" Header="Вид маркировки" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <local:HighlightedTextBlock FontWeight="SemiBold" Foreground="{StaticResource MarkingBrush}"
                                                   HighlightText="{Binding ProductTypeDisplayText}" SearchText="{Binding DataContext.SearchTextQuery, RelativeSource={RelativeSource AncestorType=Window}}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ProductTypeDisplayText}" ToolTipService.InitialShowDelay="350" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="StatusColumn" Header="Статус" Width="56" DisplayMemberBinding="{Binding StatusText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center" Background="{StaticResource DividerBrush}" />
            <Button x:Name="ToggleRecordsPaneButton" Grid.Column="1" Panel.ZIndex="1"
                    Width="25" Height="52" Padding="0" MinHeight="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    FontSize="15" FontWeight="SemiBold" Content="◀"
                    ToolTip="Скрыть список строк (Ctrl+M)"
                    Click="ToggleRecordsPane_Click" />

            <Grid Grid.Column="2" DataContext="{Binding SelectedRecord}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="10,8" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title, TargetNullValue=Файл не открыт}" />
                            <TextBlock Margin="0,2,0,0" Foreground="#555555"
                                       Text="{Binding Summary, TargetNullValue=Выберите файл обмена Frontol для анализа}" />
                            <Grid Margin="0,6,0,1"
                                  Visibility="{Binding IsProductRecord, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="2.1*" />
                                    <ColumnDefinition Width="0.85*" />
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <Border Height="34" Padding="7,0" Background="{StaticResource PrimarySoftBrush}" CornerRadius="3">
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CodeDisplayText}">
                                        <Run Foreground="{StaticResource PrimaryBrush}" Text="{Binding CodeLabel, Mode=OneWay}" /><Run FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding CodeDisplayText, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Grid.Column="1" Height="34" Margin="6,0" Padding="7,0" Background="{StaticResource SurfaceAltBrush}" CornerRadius="3">
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductNameDisplayText}">
                                        <Run Foreground="#5B5B5B" Text="{Binding ProductNameLabel, Mode=OneWay}" /><Run FontWeight="SemiBold" Text="{Binding ProductNameDisplayText, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Grid.Column="2" Height="34" Padding="7,0" Background="{StaticResource PrimarySoftBrush}" CornerRadius="3">
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PriceDisplayText}">
                                        <Run Foreground="{StaticResource PrimaryBrush}" Text="Цена: " /><Run FontWeight="Bold" Text="{Binding PriceDisplayText, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Grid.Column="3" Height="34" Margin="6,0" Padding="7,0" Background="{StaticResource SurfaceAltBrush}" CornerRadius="3">
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding BarcodeDisplayText}">
                                        <Run Foreground="#5B5B5B" Text="Штрихкод: " /><Run FontWeight="SemiBold" Text="{Binding BarcodeDisplayText, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                                <Border Grid.Column="4" Height="34" Padding="7,0" Background="{StaticResource MarkingSoftBrush}" CornerRadius="3">
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductTypeDisplayText}">
                                        <Run Foreground="{StaticResource MarkingBrush}" Text="Маркировка: " /><Run FontWeight="Bold" Foreground="{StaticResource MarkingBrush}" Text="{Binding ProductTypeDisplayText, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding StatusText}" />
                            <Border Margin="0,3,0,0" Padding="6,2" Background="{StaticResource ChangedSoftBrush}" CornerRadius="3"
                                    Visibility="{Binding IsModified, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Foreground="{StaticResource ChangedBrush}" FontWeight="SemiBold" Text="Изменено" />
                            </Border>
                            <TextBlock HorizontalAlignment="Right" Foreground="#666666" Text="{Binding KindText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="8,5" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox VerticalAlignment="Center" Content="Показывать пустые поля"
                                      IsChecked="{Binding DataContext.ShowEmptyFields, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                            <Button Margin="10,0,0,0" Padding="8,2" Click="ConfigureFields_Click"
                                    IsEnabled="{Binding DataContext.CanConfigureFields, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Content="Настроить поля..." />
                            <Button Margin="6,0,0,0" Padding="8,2" Click="EditField_Click"
                                    IsEnabled="{Binding DataContext.CanEditSelectedField, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Изменить исходное значение выбранного поля и повторно проверить строку (F2)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource IconEdit}" />
                                    <TextBlock Text="Изменить выбранное поле (F2)" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Margin="10,5,0,0" VerticalAlignment="Center" Foreground="#555555"
                                   Text="{Binding DataContext.FieldVisibilityLabel, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </WrapPanel>
                </Border>

                <DataGrid x:Name="FieldsGrid" Grid.Row="2"
                          ItemsSource="{Binding DataContext.VisibleFields, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding DataContext.SelectedField, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionUnit="CellOrRowHeader"
                          SelectedCellsChanged="FieldsGrid_SelectedCellsChanged"
                          PreviewMouseRightButtonDown="FieldsGrid_RightClick"
                          MouseDoubleClick="FieldsGrid_MouseDoubleClick"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                          RowHeaderWidth="0" RowHeight="27" ColumnHeaderHeight="28"
                          AlternatingRowBackground="{StaticResource SurfaceAltBrush}"
                          HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Копировать значение" Click="CopyFieldValue_Click" />
                            <MenuItem Header="Копировать всю строку поля" Click="CopyFieldRow_Click" />
                            <Separator />
                            <MenuItem Header="Изменить значение..." Click="EditField_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="5,3" />
                            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Number}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Number}" Value="3">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Number}" Value="55">
                                    <Setter Property="Background" Value="{StaticResource MarkingSoftBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{StaticResource MarkingBrush}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Number}" Value="32" />
                                        <Condition Binding="{Binding DataContext.IsUploadFile, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource MarkingSoftBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{StaticResource MarkingBrush}" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static core:IssueSeverity.Info}">
                                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static core:IssueSeverity.Warning}">
                                    <Setter Property="Background" Value="{StaticResource ChangedSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static core:IssueSeverity.Error}">
                                    <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="№" Binding="{Binding Number}" Width="42" />
                        <DataGridTextColumn Header="Поле" Binding="{Binding Name}" Width="210" />
                        <DataGridTemplateColumn Header="Значение" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" Text="{Binding DisplayValue}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayValue}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers><DataTrigger Binding="{Binding IsValueEmpty}" Value="True"><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" /><Setter Property="FontStyle" Value="Italic" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Расшифровка" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Interpretation}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Interpretation}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Проверка" Binding="{Binding StatusText}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="FullCellTextPanel" Grid.Row="3" Margin="0,5,0,0" Padding="7,5" Background="{StaticResource SurfaceAltBrush}" BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Top" FontWeight="SemiBold" Text="Полный текст ячейки:" />
                        <TextBox Grid.Column="1" Margin="12,0,0,0" Padding="0" MinHeight="0" MaxHeight="74"
                                 VerticalAlignment="Top" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch"
                                 TextAlignment="Left" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Text="{Binding DataContext.SelectedCellText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <GroupBox x:Name="SelectedFieldDetailsPanel" Grid.Row="4" Header="Параметры выбранного поля" Margin="0,5,0,0" Padding="6"
                          DataContext="{Binding DataContext.SelectedField, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel>
                            <StackPanel Margin="0,0,20,3" Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" FontWeight="SemiBold" Text="Поле:" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,20,3" Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" FontWeight="SemiBold" Text="№ / тип:" />
                                <TextBlock><Run Text="{Binding Number}" /><Run Text=" · " /><Run Text="{Binding DataType}" /></TextBlock>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,3" Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" FontWeight="SemiBold" Text="Обязательно:" />
                                <TextBlock Text="{Binding RequiredText}" />
                            </StackPanel>
                            <StackPanel Margin="20,0,0,3" Orientation="Horizontal">
                                <TextBlock Margin="0,0,6,0" FontWeight="SemiBold" Text="Источник:" />
                                <TextBlock Text="{Binding SourceText}" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Grid.Row="1" Margin="0,3,0,0" Text="{Binding Purpose}" TextWrapping="Wrap" />

                        <Border Grid.Row="2" Margin="0,7,0,0" Padding="7,5"
                                Background="{StaticResource SurfaceAltBrush}" BorderThickness="0"
                                Visibility="{Binding HasExtendedInterpretation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Расшифровка:" />
                                <ScrollViewer Grid.Column="1" MaxHeight="72" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding DetailInterpretation, Mode=OneWay}" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>

                <Expander Grid.Row="5" Margin="0,4,0,0" Header="Исходная строка и диагностика">
                    <Border Padding="6" Background="White" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,3,0,3" Foreground="#555555" FontSize="11" Text="{Binding Definition.ManualReference}" />
                            <TextBox Height="60" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                     Text="{Binding RawText, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </Expander>
            </Grid>
        </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Margin="6" Panel.ZIndex="5" Background="{StaticResource SurfaceBrush}" CornerRadius="5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLoadedRecords}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Width="760" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Width="78" Height="78" Source="Assets/app-logo.png" Stretch="Uniform" />
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                           Text="Анализатор файла обмена Frontol" />
                <TextBlock Margin="18,7" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Выберите направление обмена. После открытия программа включит подходящий интерфейс и справочник; при перетаскивании формат определяется автоматически." />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Padding="16,14" Background="White" BorderBrush="#C9D7E5" BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Файл загрузки в Frontol" />
                            <TextBlock Margin="0,5,0,10" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                       Text="Учётная система → Frontol&#x0a;Команды $$$ и строки справочников" />
                            <Button MinWidth="210" HorizontalAlignment="Center" Padding="14,7" Click="OpenUploadFile_Click" IsDefault="True">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource IconOpen}" /><TextBlock Text="Выбрать файл загрузки…" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="16,14" Background="White" BorderBrush="#BFD7C6" BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Отчёт о продажах" />
                            <TextBlock Margin="0,5,0,10" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                       Text="Frontol → учётная система&#x0a;Транзакции продаж, оплат и смен" />
                            <Button MinWidth="210" HorizontalAlignment="Center" Padding="14,7" Click="OpenSalesReport_Click">
                                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource ToolbarIcon}" Data="{StaticResource IconOpen}" /><TextBlock Text="Выбрать отчёт о продажах…" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                           Text="Ctrl+O — автоопределение · последние файлы — в меню «Файл»" />
            </StackPanel>
        </Border>

        <StatusBar Grid.Row="5" Background="#E7E7E7" BorderBrush="#C8C8C8" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding VersionLabel}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="Разработчик: Maximum IT" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
