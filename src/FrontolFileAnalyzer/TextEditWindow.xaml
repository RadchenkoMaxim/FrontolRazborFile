<Window x:Class="FrontolFileAnalyzer.TextEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменить значение"
        Icon="Assets/app.ico"
        Width="620"
        Height="300"
        MinWidth="360"
        MinHeight="210"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <ScrollViewer x:Name="LayoutScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="VerticalOnly">
            <Grid Height="{Binding ActualHeight, ElementName=LayoutScrollViewer}"
                  MinHeight="176">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,9">
                    <TextBlock x:Name="PromptText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Редактируется вся физическая строка файла целиком."
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBox x:Name="ValueText"
                         Grid.Row="1"
                         Padding="8,6"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         TextWrapping="Wrap"
                         VerticalAlignment="Stretch"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled" />

                <WrapPanel Grid.Row="2"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Right">
                    <Button MinWidth="96"
                            Margin="0,0,7,0"
                            IsDefault="True"
                            Content="Применить"
                            Click="Apply_Click" />
                    <Button MinWidth="84"
                            IsCancel="True"
                            Content="Отмена" />
                </WrapPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
