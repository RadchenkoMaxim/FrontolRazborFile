<Window x:Class="FrontolFileAnalyzer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="620"
        Height="340"
        MinWidth="500"
        MinHeight="300"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        Icon="Assets/app.ico"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      Margin="0,0,0,12"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="112"
                        Height="112"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="White"
                        BorderBrush="#C8C8C8"
                        BorderThickness="1">
                    <Image Margin="8" Source="Assets/app-logo.png" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock FontSize="21"
                               FontWeight="SemiBold"
                               Text="Анализатор обмена Frontol"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,12"
                               Foreground="#555555"
                               Text="{Binding VersionLabel}" />
                    <TextBlock Text="Построчный разбор файлов загрузки Frontol 6 с расшифровкой полей, кодов маркировки и диагностикой формата."
                               TextWrapping="Wrap" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="Разработчик:" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="Maximum IT" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Margin="0,5,0,0" FontWeight="SemiBold"
                                   Text="Сайт разработчика:" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" TextWrapping="Wrap">
                            <Hyperlink NavigateUri="https://maximumit25.ru"
                                       RequestNavigate="DeveloperLink_RequestNavigate">maximumit25.ru</Hyperlink>
                        </TextBlock>
                        <TextBlock Grid.Row="2" Margin="0,5,0,0" FontWeight="SemiBold"
                                   Text="Платформа:" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,5,0,0"
                                   Text="Windows x64, .NET 10 Desktop" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Button Grid.Row="1"
                MinWidth="90"
                Padding="12,4"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="Close_Click"
                Content="Закрыть" />
    </Grid>
</Window>
