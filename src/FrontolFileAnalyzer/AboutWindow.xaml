<Window x:Class="FrontolFileAnalyzer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О программе"
        Width="590" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        Icon="Assets/app.ico"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Width="112" Height="112" VerticalAlignment="Top" Background="White" BorderBrush="#C8C8C8" BorderThickness="1">
            <Image Margin="8" Source="Assets/app-logo.png" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Column="1">
            <TextBlock FontSize="21" FontWeight="SemiBold" Text="Анализатор обмена Frontol" />
            <TextBlock Margin="0,3,0,12" Foreground="#555555" Text="{Binding VersionLabel}" />
            <TextBlock TextWrapping="Wrap"
                       Text="Построчный разбор файлов загрузки Frontol 6 с расшифровкой полей, кодов маркировки и диагностикой формата." />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="Разработчик:" />
                <TextBlock Grid.Column="1">
                    <Hyperlink NavigateUri="https://maximumit25.ru/nfr" RequestNavigate="DeveloperLink_RequestNavigate">
                        Maximum IT
                    </Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="1" Margin="0,5,0,0" FontWeight="SemiBold" Text="Сайт:" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,5,0,0">
                    <Hyperlink NavigateUri="https://maximumit25.ru/nfr" RequestNavigate="DeveloperLink_RequestNavigate">
                        https://maximumit25.ru/nfr
                    </Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="2" Margin="0,5,0,0" FontWeight="SemiBold" Text="Платформа:" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" Text="Windows x64, .NET 10 Desktop" />
            </Grid>
        </StackPanel>

        <Button Grid.Row="1" Grid.ColumnSpan="2" Width="90" HorizontalAlignment="Right"
                IsDefault="True" Click="Close_Click" Content="Закрыть" />
    </Grid>
</Window>
