<Window x:Class="FrontolFileAnalyzer.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сводная статистика файла Frontol"
        Icon="Assets/app.ico"
        Width="1100"
        Height="700"
        MinWidth="620"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style x:Key="StatisticCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="#E5EAF1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <Style x:Key="QuietDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E8ECF1" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="MinColumnWidth" Value="44" />
            <Setter Property="RowHeight" Value="29" />
            <Setter Property="ColumnHeaderHeight" Value="32" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="EnableRowVirtualization" Value="True" />
        </Style>

        <Style x:Key="QuietColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F4F8" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="EllipsisCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="PageScroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <Grid x:Name="ContentRoot" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="4,0,4,8">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#172033"
                           Text="Сводная статистика" />
                <TextBlock Margin="0,3,0,0" Foreground="#64748B" TextWrapping="Wrap"
                           Text="{Binding SummarySubtitle}" />
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="2" Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource StatisticCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding AccentBrush}" CornerRadius="2" />
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Foreground="#64748B" FontSize="11"
                                               Text="{Binding Caption}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0" FontSize="20" FontWeight="SemiBold"
                                               Foreground="#172033" Text="{Binding FormattedValue}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2" Margin="4,6,4,0" Padding="10,8"
                    Background="#F8FAFC" BorderBrush="#DDE4ED" BorderThickness="1" CornerRadius="4">
                <TextBlock Foreground="#475569" TextWrapping="Wrap" LineHeight="18">
                    <Run FontWeight="SemiBold" Foreground="#9B3D3D" Text="Ошибка" />
                    <Run Text=" — нарушение формата, типа данных или обязательности поля. " />
                    <Run FontWeight="SemiBold" Foreground="#986100" Text="Предупреждение" />
                    <Run Text=" — подозрительное или неизвестное анализатору значение; файл при этом всё равно разобран. " />
                    <Run FontWeight="SemiBold" Text="Все счётчики показывают количество строк, а не сообщений." />
                </TextBlock>
            </Border>

            <Grid x:Name="TablesHost" Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TablesLeftColumn" Width="1.08*" />
                    <ColumnDefinition x:Name="TablesColumnGap" Width="16" />
                    <ColumnDefinition x:Name="TablesRightColumn" Width="0.92*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TablesTopRow" Height="*" />
                    <RowDefinition x:Name="TablesRowGap" Height="0" />
                    <RowDefinition x:Name="TablesBottomRow" Height="0" />
                </Grid.RowDefinitions>

                <Grid x:Name="MarkingSection" Grid.Row="0" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,7">
                        <TextBlock DockPanel.Dock="Right" Margin="8,2,0,0" Foreground="#64748B"
                                   Text="{Binding MarkingSummary}" />
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#24324A"
                                   Text="Товары по виду маркировки" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" MinHeight="150"
                              Style="{StaticResource QuietDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource QuietColumnHeaderStyle}"
                              ItemsSource="{Binding MarkingRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="58"
                                                ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                            <DataGridTextColumn Header="Вид маркировки" Binding="{Binding Name}" Width="*"
                                                ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                            <DataGridTextColumn Header="Товаров" Binding="{Binding Count, StringFormat={}{0:N0}}" Width="78"
                                                ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                            <DataGridTextColumn Header="Доля" Binding="{Binding ShareText}" Width="66"
                                                ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="CommandSection" Grid.Row="0" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,7">
                        <TextBlock DockPanel.Dock="Right" Margin="8,2,0,0" Foreground="#64748B"
                                   Text="{Binding CommandSummary}" />
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#24324A"
                                   Text="{Binding EntitySectionTitle}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" MinHeight="150"
                              Style="{StaticResource QuietDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource QuietColumnHeaderStyle}"
                              ItemsSource="{Binding CommandRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Команда / транзакция" Binding="{Binding DisplayName}" Width="*"
                                                ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                            <DataGridTextColumn Header="Строк данных" Binding="{Binding DataRowCount, StringFormat={}{0:N0}}" Width="104"
                                                ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                            <DataGridTextColumn Header="Ошибок, строк" Binding="{Binding ErrorCount, StringFormat={}{0:N0}}" Width="96"
                                                ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                            <DataGridTextColumn Header="Предупр., строк" Binding="{Binding WarningCount, StringFormat={}{0:N0}}" Width="112"
                                                ElementStyle="{StaticResource EllipsisCellTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <DockPanel Grid.Row="5" Margin="4,12,4,0">
                <Button DockPanel.Dock="Right" Width="96" Margin="12,0,0,0"
                        IsCancel="True" Content="Закрыть" />
                <TextBlock VerticalAlignment="Center" Foreground="#64748B" TextTrimming="CharacterEllipsis"
                           Text="Статистика рассчитана по строкам исходного файла." />
            </DockPanel>
        </Grid>
    </ScrollViewer>
</Window>
