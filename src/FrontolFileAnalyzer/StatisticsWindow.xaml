<Window x:Class="FrontolFileAnalyzer.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сводная статистика файла Frontol"
        Width="1180"
        Height="720"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="StatisticCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="#E5EAF1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <Style x:Key="QuietDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E8ECF1" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>

        <Style x:Key="QuietColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F4F8" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#172033" Text="Сводная статистика" />
            <TextBlock Margin="0,4,0,0" Foreground="#64748B"
                       Text="Состав файла, распределение маркировки и диагностика команд" />
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource StatisticCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding AccentBrush}" CornerRadius="2" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Foreground="#64748B" FontSize="11" Text="{Binding Caption}" />
                                <TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold"
                                           Foreground="#172033" Text="{Binding FormattedValue}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#24324A"
                               Text="Товары по виду маркировки" />
                    <TextBlock Margin="8,2,0,0" Foreground="#64748B"
                               Text="{Binding MarkingSummary}" />
                </DockPanel>
                <DataGrid Grid.Row="1"
                          Style="{StaticResource QuietDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource QuietColumnHeaderStyle}"
                          ItemsSource="{Binding MarkingRows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="70" />
                        <DataGridTextColumn Header="Вид маркировки" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Товаров" Binding="{Binding Count, StringFormat={}{0:N0}}" Width="90" />
                        <DataGridTextColumn Header="Доля" Binding="{Binding ShareText}" Width="82" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#24324A"
                               Text="Команды файла" />
                    <TextBlock Margin="8,2,0,0" Foreground="#64748B"
                               Text="{Binding CommandSummary}" />
                </DockPanel>
                <DataGrid Grid.Row="1"
                          Style="{StaticResource QuietDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource QuietColumnHeaderStyle}"
                          ItemsSource="{Binding CommandRows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Команда" Binding="{Binding DisplayName}" Width="*" />
                        <DataGridTextColumn Header="Строк данных" Binding="{Binding DataRowCount, StringFormat={}{0:N0}}" Width="104" />
                        <DataGridTextColumn Header="Ошибок" Binding="{Binding ErrorCount, StringFormat={}{0:N0}}" Width="72" />
                        <DataGridTextColumn Header="Предупр." Binding="{Binding WarningCount, StringFormat={}{0:N0}}" Width="82" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="#64748B"
                       Text="Счётчики ошибок и предупреждений показывают количество строк, а не отдельных сообщений." />
            <Button Width="96" Margin="12,0,0,0" HorizontalAlignment="Right" DockPanel.Dock="Right"
                    IsCancel="True" Content="Закрыть" />
        </DockPanel>
    </Grid>
</Window>
