<Window x:Class="FrontolFileAnalyzer.FieldVisibilityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка видимости полей"
        Icon="Assets/app.ico"
        Width="600" Height="620" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Background="White" BorderBrush="#CFCFCF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding CommandTitle}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding CommandTitle}" />
                <TextBlock Grid.Row="1"
                           Margin="0,3,0,0"
                           Foreground="#555555"
                           Text="Снимите флажок, чтобы скрыть поле в таблице."
                           TextWrapping="Wrap" />
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="#555555"
                               Text="Поиск" />
                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             TextChanged="Search_TextChanged"
                             ToolTip="Поиск по номеру или названию поля" />
                </Grid>
            </Grid>
        </Border>

        <ListView Grid.Row="1"
                  Margin="0,8"
                  ItemsSource="{Binding FieldsView}"
                  BorderBrush="#CFCFCF"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <CheckBox Padding="4"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Number}" />
                            <TextBlock Grid.Column="1"
                                       Margin="0,0,8,0"
                                       Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}" />
                            <TextBlock Grid.Column="2" Foreground="#666666" Text="{Binding StateText}" />
                        </Grid>
                    </CheckBox>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel>
                <Button Margin="0,0,6,4"
                        Click="SelectAll_Click"
                        Content="Показать найденные"
                        ToolTip="Показать поля, отображённые текущим поиском" />
                <Button Margin="0,0,6,4"
                        Click="SelectNone_Click"
                        Content="Скрыть найденные"
                        ToolTip="Скрыть поля, отображённые текущим поиском" />
                <Button Margin="0,0,0,4"
                        Click="OnlyFilled_Click"
                        Content="Среди найденных — только заполненные"
                        ToolTip="Изменить только поля, отображённые текущим поиском" />
            </WrapPanel>
            <StackPanel Grid.Row="1"
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="80" IsDefault="True" Click="Ok_Click" Content="ОК" />
                <Button Width="80" Margin="6,0,0,0" IsCancel="True" Content="Отмена" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
